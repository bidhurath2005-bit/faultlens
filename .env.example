# FaultLens environment template.
# Run scripts/setup.ps1 (Windows) or scripts/setup.sh to create .env with random secrets.
# Never commit .env.  Values marked __GENERATE__ are replaced with random strings by the setup script.

ENVIRONMENT=local

# --- Datastores ---------------------------------------------------------------
POSTGRES_PASSWORD=__GENERATE__
FAULTLENS_DB_PASSWORD=__GENERATE__
SHOP_DB_PASSWORD=__GENERATE__
REDIS_PASSWORD=__GENERATE__

# --- Auth ---------------------------------------------------------------------
JWT_SECRET=__GENERATE__
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_HOURS=12
# First-run admin. Created only when the users table is empty. Change after first login.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=__GENERATE__
# Set true only behind HTTPS (marks the refresh cookie Secure).
COOKIE_SECURE=false

# --- Fault injection (local demo only) -------------------------------------------
FAULT_INJECTION_ENABLED=true
FAULT_ADMIN_TOKEN=__GENERATE__

# --- Traffic generator --------------------------------------------------------
TRAFFIC_RPS=8
TRAFFIC_SEED=1234
TRAFFIC_AUTOSTART=true

# --- Observability ------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=__GENERATE__

# --- Optional LLM explanation provider (core works without it) ----------------
# LLM_PROVIDER: none | anthropic | openai_compatible (e.g. a local Ollama at http://host.docker.internal:11434/v1)
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
